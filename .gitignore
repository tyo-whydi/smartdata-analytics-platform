# .gitignore

# Java / Maven
*.class
*.log
*.jar
*.war
*.ear
target/
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db

# Node / Frontend
node_modules/
frontend/dist/
frontend/.cache/
frontend/.vite/

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Environment
.env
.env.*

# Docker
*.pid

# Project data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Build artifacts
coverage/
*.sqlite3
